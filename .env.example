# Supabase project URL and a server-only secret key.
# Never rename these with NEXT_PUBLIC_ or put them in browser code.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=YOUR_SERVER_ONLY_SECRET_KEY
# Older Supabase projects can use this legacy key instead. Keep it server-only.
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY

# Optional. Leave empty until you are ready to enable live YouTube search.
YOUTUBE_API_KEY=

# Public URL of this app. Used to check browser write requests.
APP_URL=http://localhost:3000

# Internal safeguard. This is the app's own cap, not Google's quota reading.
YOUTUBE_DAILY_SEARCH_LIMIT=40
API_RATE_LIMIT_PER_MINUTE=60
PORT=3000
