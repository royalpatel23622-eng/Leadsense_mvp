# Supabase project URL and a server-only secret key.
# Never rename these with NEXT_PUBLIC_ or put them in browser code.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=YOUR_SERVER_ONLY_SECRET_KEY
# Older Supabase projects can use this legacy key instead. Keep it server-only.
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY

# Optional. Leave empty until you are ready to enable live YouTube search.
YOUTUBE_API_KEY=

# Public URL of this app. Used to check browser write requests.
APP_URL=http://localhost:3000
# Optional trusted proxy header. On Render use its proxy-overwritten CF header;
# never enable X-Forwarded-For unless your proxy sanitizes it.
TRUSTED_CLIENT_IP_HEADER=

# Internal safeguard. This is the app's own cap, not Google's quota reading.
YOUTUBE_DAILY_SEARCH_LIMIT=40
YOUTUBE_DAILY_OTHER_UNITS_LIMIT=9000
API_RATE_LIMIT_PER_MINUTE=60
API_AUTH_LOGIN_RATE_LIMIT=10
API_AUTH_SIGNUP_RATE_LIMIT=5
API_YOUTUBE_SEARCH_RATE_LIMIT=12
API_YOUTUBE_INSPECT_RATE_LIMIT=12
YOUTUBE_OPERATION_TIMEOUT_MS=25000
# Default daily search limit per signed-in account; admins can set an override.
USER_DAILY_SEARCH_LIMIT=10
USER_DAILY_ANALYSIS_LIMIT=20
USER_DAILY_API_CALL_LIMIT=120
PORT=3000
